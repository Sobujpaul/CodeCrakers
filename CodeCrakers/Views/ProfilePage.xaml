<UserControl x:Class="CodeCrakers.Views.ProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Profile Settings" 
                       Foreground="{StaticResource titleColor1}"
                       FontFamily="Montserrat"
                       FontSize="24"
                       FontWeight="Bold"/>
            <TextBlock Text="Manage your account information and preferences" 
                       Foreground="{StaticResource plainTextColor1}"
                       FontFamily="Montserrat"
                       FontSize="14"
                       Margin="0,5,0,0"/>
        </StackPanel>
        
        <!-- Profile Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left Column - Basic Info -->
                <Border Grid.Column="0" 
                        Background="{StaticResource panelColor}"
                        CornerRadius="10"
                        Padding="25">
                    <StackPanel>
                        <TextBlock Text="Basic Information" 
                                   Foreground="{StaticResource titleColor2}"
                                   FontFamily="Montserrat"
                                   FontSize="18"
                                   FontWeight="Medium"
                                   Margin="0,0,0,20"/>
                        
                        <!-- Username -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Username" 
                                       Foreground="{StaticResource titleColor1}"
                                       FontFamily="Montserrat"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="txtUsername" 
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource panelOverColor}"
                                     Foreground="{StaticResource titleColor1}"
                                     FontFamily="Montserrat"
                                     FontSize="14"
                                     Padding="12,8"
                                     BorderThickness="0"
                                     CaretBrush="{StaticResource titleColor1}"/>
                        </StackPanel>
                        
                        <!-- Email -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Email Address" 
                                       Foreground="{StaticResource titleColor1}"
                                       FontFamily="Montserrat"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="txtEmail" 
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource panelOverColor}"
                                     Foreground="{StaticResource titleColor1}"
                                     FontFamily="Montserrat"
                                     FontSize="14"
                                     Padding="12,8"
                                     BorderThickness="0"
                                     CaretBrush="{StaticResource titleColor1}"/>
                        </StackPanel>
                        
                        <!-- Current Password -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Current Password" 
                                       Foreground="{StaticResource titleColor1}"
                                       FontFamily="Montserrat"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Margin="0,0,0,5"/>
                            <PasswordBox x:Name="txtCurrentPassword" 
                                         Background="{StaticResource panelOverColor}"
                                         Foreground="{StaticResource titleColor1}"
                                         FontFamily="Montserrat"
                                         FontSize="14"
                                         Padding="12,8"
                                         BorderThickness="0"/>
                        </StackPanel>
                        
                        <!-- New Password -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="New Password (Optional)" 
                                       Foreground="{StaticResource titleColor1}"
                                       FontFamily="Montserrat"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Margin="0,0,0,5"/>
                            <PasswordBox x:Name="txtNewPassword" 
                                         Background="{StaticResource panelOverColor}"
                                         Foreground="{StaticResource titleColor1}"
                                         FontFamily="Montserrat"
                                         FontSize="14"
                                         Padding="12,8"
                                         BorderThickness="0"/>
                        </StackPanel>
                        
                        <!-- Confirm New Password -->
                        <StackPanel Margin="0,0,0,25">
                            <TextBlock Text="Confirm New Password" 
                                       Foreground="{StaticResource titleColor1}"
                                       FontFamily="Montserrat"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Margin="0,0,0,5"/>
                            <PasswordBox x:Name="txtConfirmPassword" 
                                         Background="{StaticResource panelOverColor}"
                                         Foreground="{StaticResource titleColor1}"
                                         FontFamily="Montserrat"
                                         FontSize="14"
                                         Padding="12,8"
                                         BorderThickness="0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Right Column - Additional Info -->
                <Border Grid.Column="2" 
                        Background="{StaticResource panelColor}"
                        CornerRadius="10"
                        Padding="25">
                    <StackPanel>
                        <TextBlock Text="Additional Information" 
                                   Foreground="{StaticResource titleColor2}"
                                   FontFamily="Montserrat"
                                   FontSize="18"
                                   FontWeight="Medium"
                                   Margin="0,0,0,20"/>
                        
                        <!-- Country -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Country" 
                                       Foreground="{StaticResource titleColor1}"
                                       FontFamily="Montserrat"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="txtCountry" 
                                     Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource panelOverColor}"
                                     Foreground="{StaticResource titleColor1}"
                                     FontFamily="Montserrat"
                                     FontSize="14"
                                     Padding="12,8"
                                     BorderThickness="0"
                                     CaretBrush="{StaticResource titleColor1}"/>
                        </StackPanel>
                        
                        <!-- University -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="University/Institution" 
                                       Foreground="{StaticResource titleColor1}"
                                       FontFamily="Montserrat"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="txtUniversity" 
                                     Text="{Binding University, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource panelOverColor}"
                                     Foreground="{StaticResource titleColor1}"
                                     FontFamily="Montserrat"
                                     FontSize="14"
                                     Padding="12,8"
                                     BorderThickness="0"
                                     CaretBrush="{StaticResource titleColor1}"/>
                        </StackPanel>
                        
                        <!-- Profile Visibility -->
                        <StackPanel Margin="0,0,0,25">
                            <TextBlock Text="Profile Visibility" 
                                       Foreground="{StaticResource titleColor1}"
                                       FontFamily="Montserrat"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Margin="0,0,0,10"/>
                            
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="chkHideProfile" 
                                          Content="Hide my profile from leaderboard"
                                          Foreground="{StaticResource titleColor1}"
                                          FontFamily="Montserrat"
                                          FontSize="12"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <TextBlock Text="When enabled, your profile will not appear in public leaderboards" 
                                       Foreground="{StaticResource plainTextColor1}"
                                       FontFamily="Montserrat"
                                       FontSize="11"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
        
        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button x:Name="btnCancel" 
                    Background="{StaticResource panelColor}"
                    Foreground="{StaticResource titleColor1}"
                    BorderThickness="0"
                    Click="btnCancel_Click"
                    Margin="0,0,10,0"
                    Padding="20,10"
                    FontFamily="Montserrat"
                    FontSize="14"
                    FontWeight="Medium">
                <StackPanel Orientation="Horizontal">
                    <fa:IconImage Icon="Xmark" 
                                 Foreground="{StaticResource titleColor1}" 
                                 Width="16" 
                                 Height="16" 
                                 Margin="0,0,8,0"/>
                    <TextBlock Text="Cancel" 
                               Foreground="{StaticResource titleColor1}"
                               FontFamily="Montserrat"
                               FontSize="14"
                               FontWeight="Medium"/>
                </StackPanel>
            </Button>
            
            <Button x:Name="btnSave" 
                    Background="{StaticResource color6}"
                    Foreground="White"
                    BorderThickness="0"
                    Click="btnSave_Click"
                    Padding="20,10"
                    FontFamily="Montserrat"
                    FontSize="14"
                    FontWeight="Medium">
                <StackPanel Orientation="Horizontal">
                    <fa:IconImage Icon="FloppyDisk" 
                                 Foreground="White" 
                                 Width="16" 
                                 Height="16" 
                                 Margin="0,0,8,0"/>
                    <TextBlock Text="Save Changes" 
                               Foreground="White"
                               FontFamily="Montserrat"
                               FontSize="14"
                               FontWeight="Medium"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
