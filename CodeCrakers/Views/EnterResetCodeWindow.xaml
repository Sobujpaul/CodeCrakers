<Window x:Class="CodeCrakers.Views.EnterResetCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Reset Code" Height="180" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Border Padding="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Enter the code sent to your email" FontWeight="Bold"/>
            <TextBox x:Name="txtCode" Grid.Row="1" Margin="0,8,0,10"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="OK" Width="80" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>