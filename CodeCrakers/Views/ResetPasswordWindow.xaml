<Window x:Class="CodeCrakers.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Password" Height="300" Width="400" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Enter the token sent to your email:" FontWeight="Bold"/>
        <TextBox x:Name="txtToken" Grid.Row="1" Margin="0,5,0,10"/>
        <StackPanel Grid.Row="2" Margin="0,0,0,5">
            <TextBlock Text="New Password" FontSize="12" Foreground="Gray"/>
            <PasswordBox x:Name="txtNewPass" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Confirm Password" FontSize="12" Foreground="Gray"/>
            <PasswordBox x:Name="txtConfirmPass" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Reset" Width="80" Margin="0,0,0,0" Click="Reset_Click"/>
        </StackPanel>
    </Grid>
</Window>