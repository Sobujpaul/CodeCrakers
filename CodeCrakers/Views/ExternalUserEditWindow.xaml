<Window x:Class="CodeCrakers.Views.ExternalUserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit External User" WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight"
        Background="{StaticResource panelColor}">
    <Border Padding="20">
        <StackPanel Width="420">
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource titleColor2}"/>
                    <Setter Property="FontFamily" Value="Montserrat"/>
                    <Setter Property="Margin" Value="0,8,0,2"/>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Background" Value="{StaticResource panelOverColor}"/>
                    <Setter Property="Foreground" Value="{StaticResource titleColor1}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource color1}"/>
                    <Setter Property="Padding" Value="6"/>
                    <Setter Property="FontFamily" Value="Montserrat"/>
                </Style>
            </StackPanel.Resources>

            <TextBlock Text="Display Name"/>
            <TextBox x:Name="txtDisplayName"/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Codeforces"/>
                    <TextBox x:Name="txtCodeforces"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="LeetCode"/>
                    <TextBox x:Name="txtLeetCode"/>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CodeChef"/>
                    <TextBox x:Name="txtCodeChef"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="AtCoder"/>
                    <TextBox x:Name="txtAtcoder"/>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Country"/>
                    <TextBox x:Name="txtCountry"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="University"/>
                    <TextBox x:Name="txtUniversity"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="btnSave" Content="Save" Width="80" Margin="0,0,8,0"
                        Background="{StaticResource color2}" Foreground="{StaticResource titleColor1}"
                        BorderBrush="Transparent" Click="btnSave_Click"/>
                <Button Content="Cancel" Width="80" IsCancel="True"
                        Background="{StaticResource panelOverColor}" Foreground="{StaticResource titleColor1}"
                        BorderBrush="{StaticResource color1}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>


