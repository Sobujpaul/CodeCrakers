<UserControl x:Class="CodeCrakers.Views.ComparePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp">

    <UserControl.Resources>
        <!-- Watermark / Placeholder TextBox Style -->
        <Style x:Key="WatermarkTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource titleColor1}"/>
            <Setter Property="FontFamily" Value="Montserrat"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border Background="{StaticResource panelColor}"
                                    BorderBrush="{StaticResource panelOverColor}"
                                    BorderThickness="1"
                                    CornerRadius="6"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                            <TextBlock Text="{TemplateBinding Tag}"
                                       Margin="12,0,0,0"
                                       Foreground="{StaticResource plainTextColor1}"
                                       Opacity="0.5"
                                       FontFamily="Montserrat"
                                       FontSize="14"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Comparing Users" FontFamily="Montserrat" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource titleColor1}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="btnRefresh" Content="🔄" Click="btnRefresh_Click"
                        Background="{StaticResource color6}" Foreground="White"
                        Width="35" Height="35" Margin="0,0,0,0" BorderBrush="Transparent"
                        ToolTip="Refresh" Cursor="Hand" FontSize="14"/>
            </StackPanel>
        </Grid>

        <!-- Central Input Section (moved upward) -->
        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" MinWidth="500" Margin="0,60,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Two handles row -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,15">
                <TextBox x:Name="txtHandle1" Width="220" Height="40" Margin="0,0,25,0"
                         Text="Handle 1" Foreground="Gray"
                         Background="{StaticResource panelOverColor}" BorderBrush="{StaticResource color1}" BorderThickness="1"
                         Padding="10,5" FontFamily="Montserrat" FontSize="14"
                         GotFocus="Handle_GotFocus" LostFocus="Handle_LostFocus"/>
                <TextBox x:Name="txtHandle2" Width="220" Height="40"
                         Text="Handle 2" Foreground="Gray"
                         Background="{StaticResource panelOverColor}" BorderBrush="{StaticResource color1}" BorderThickness="1"
                         Padding="10,5" FontFamily="Montserrat" FontSize="14"
                         GotFocus="Handle_GotFocus" LostFocus="Handle_LostFocus"/>
            </StackPanel>

            <!-- Compare button row -->
            <Button x:Name="btnCompare" Grid.Row="1" Content="Compare" Click="btnCompare_Click"
                    HorizontalAlignment="Center" Width="160" Height="42"
                    FontFamily="Montserrat" FontSize="16" FontWeight="SemiBold"
                    Background="{StaticResource color2}" Foreground="White"
                    BorderBrush="Transparent" Cursor="Hand"/>
        </Grid>
    </Grid>
</UserControl>