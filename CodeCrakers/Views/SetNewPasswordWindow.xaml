<Window x:Class="CodeCrakers.Views.SetNewPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set New Password" Height="240" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Border Padding="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Enter Username and New Password" FontWeight="Bold"/>
            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <TextBlock Text="Username" FontSize="12"/>
                <TextBox x:Name="txtUsername"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <TextBlock Text="New Password" FontSize="12"/>
                <PasswordBox x:Name="txtNewPass"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                <TextBlock Text="Confirm Password" FontSize="12"/>
                <PasswordBox x:Name="txtConfirmPass"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Done" Width="80" Click="Done_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>