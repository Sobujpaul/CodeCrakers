<UserControl x:Class="CodeCrakers.Views.CompareResultPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Force all text to white on this page -->
        <!-- Override commonly used brushes to white -->
        <SolidColorBrush x:Key="titleColor1" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="plainTextColor1" Color="#FFFFFF"/>

        <!-- Panel backgrounds keep using app background colors -->
        <SolidColorBrush x:Key="ComparePanelBackground" Color="{StaticResource primaryBackColor1}"/>
        <SolidColorBrush x:Key="ComparePanelAltBackground" Color="{StaticResource primaryBackColor2}"/>

        <!-- Local text brushes set to white -->
        <SolidColorBrush x:Key="CompareLabelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CompareValueBrush" Color="#FFFFFF"/>
        <Style x:Key="CompareLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CompareLabelBrush}"/>
            <Setter Property="FontFamily" Value="Montserrat"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="CompareValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CompareValueBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CompareHeadline" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CompareValueBrush}"/>
            <Setter Property="FontFamily" Value="Montserrat"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- Default TextBlock style to ensure white if not otherwise styled -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="← Back" Click="Back_Click" Width="90" Height="32" Margin="0,0,15,0"
                    Background="{StaticResource color2}" Foreground="White" BorderBrush="Transparent"
                    FontFamily="Montserrat" Cursor="Hand"/>
            <TextBlock x:Name="txtTitle" Grid.Column="1" Text="Compare" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="Montserrat" FontSize="22" FontWeight="Bold" Foreground="{StaticResource titleColor1}"/>
            <TextBlock Grid.Column="2" x:Name="txtStatus" Text="Loading..." Foreground="{StaticResource plainTextColor1}" FontFamily="Montserrat" FontSize="14" VerticalAlignment="Center"/>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Compact top comparison section: two user cards side-by-side, then Differences below -->
                <Grid HorizontalAlignment="Center" MaxWidth="1200">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left User Panel -->
            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource ComparePanelBackground}" Padding="15" CornerRadius="8" BorderBrush="{StaticResource panelOverColor}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="txtHandle1" Text="Handle1" Style="{StaticResource CompareHeadline}" FontSize="20"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <TextBlock Text="Rating:" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock Text=" " Width="4"/>
                        <TextBlock x:Name="txtRating1" Style="{StaticResource CompareValueText}"/>
                        <TextBlock Text="  (Max:" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="txtMaxRating1" Style="{StaticResource CompareValueText}"/>
                        <TextBlock Text=")" Style="{StaticResource CompareLabelText}"/>
                    </StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="Rank:" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="txtRank1" Style="{StaticResource CompareValueText}" Margin="4,0,14,0"/>
                        <TextBlock Text="Max Rank:" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="txtMaxRank1" Style="{StaticResource CompareValueText}" Margin="4,0,0,0"/>
                    </WrapPanel>
                    <UniformGrid Columns="2" Rows="5" Margin="0,0,0,5" HorizontalAlignment="Stretch">
                        <TextBlock Text="Solved" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="txtSolved1" Style="{StaticResource CompareValueText}"/>
                        <TextBlock Text="Contests" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="txtContests1" Style="{StaticResource CompareValueText}"/>
                        <TextBlock Text="Success %" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="txtSuccess1" Style="{StaticResource CompareValueText}"/>
                        <TextBlock Text="Submissions" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="txtSubmissions1" Style="{StaticResource CompareValueText}"/>
                        <TextBlock Text="Friends" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="txtFriends1" Style="{StaticResource CompareValueText}"/>
                    </UniformGrid>
                    <TextBlock x:Name="txtLastActivity1" Style="{StaticResource CompareLabelText}" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Right User Panel -->
            <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource ComparePanelBackground}" Padding="15" CornerRadius="8" BorderBrush="{StaticResource panelOverColor}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="txtHandle2" Text="Handle2" Style="{StaticResource CompareHeadline}" FontSize="20"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <TextBlock Text="Rating:" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock Text=" " Width="4"/>
                        <TextBlock x:Name="txtRating2" Style="{StaticResource CompareValueText}"/>
                        <TextBlock Text="  (Max:" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="txtMaxRating2" Style="{StaticResource CompareValueText}"/>
                        <TextBlock Text=")" Style="{StaticResource CompareLabelText}"/>
                    </StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="Rank:" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="txtRank2" Style="{StaticResource CompareValueText}" Margin="4,0,14,0"/>
                        <TextBlock Text="Max Rank:" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="txtMaxRank2" Style="{StaticResource CompareValueText}" Margin="4,0,0,0"/>
                    </WrapPanel>
                    <UniformGrid Columns="2" Rows="5" Margin="0,0,0,5" HorizontalAlignment="Stretch">
                        <TextBlock Text="Solved" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="txtSolved2" Style="{StaticResource CompareValueText}"/>
                        <TextBlock Text="Contests" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="txtContests2" Style="{StaticResource CompareValueText}"/>
                        <TextBlock Text="Success %" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="txtSuccess2" Style="{StaticResource CompareValueText}"/>
                        <TextBlock Text="Submissions" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="txtSubmissions2" Style="{StaticResource CompareValueText}"/>
                        <TextBlock Text="Friends" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="txtFriends2" Style="{StaticResource CompareValueText}"/>
                    </UniformGrid>
                    <TextBlock x:Name="txtLastActivity2" Style="{StaticResource CompareLabelText}" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Differences Section BELOW the two user panels -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="{StaticResource ComparePanelAltBackground}" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Differences" Style="{StaticResource CompareHeadline}" FontSize="16" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                    <Separator Margin="0,0,0,6"/>
                    <UniformGrid Columns="2" Rows="7" Margin="0,0,0,5">
                        <TextBlock Text="Rating Δ" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="diffRating" FontFamily="Montserrat" Foreground="{StaticResource titleColor1}"/>
                        <TextBlock Text="Max Rating Δ" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="diffMaxRating" FontFamily="Montserrat" Foreground="{StaticResource titleColor1}"/>
                        <TextBlock Text="Solved Δ" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="diffSolved" FontFamily="Montserrat" Foreground="{StaticResource titleColor1}"/>
                        <TextBlock Text="Contests Δ" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="diffContests" FontFamily="Montserrat" Foreground="{StaticResource titleColor1}"/>
                        <TextBlock Text="Success% Δ" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="diffSuccess" FontFamily="Montserrat" Foreground="{StaticResource titleColor1}"/>
                        <TextBlock Text="Subs Δ" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="diffSubmissions" FontFamily="Montserrat" Foreground="{StaticResource titleColor1}"/>
                        <TextBlock Text="Friends Δ" Style="{StaticResource CompareLabelText}"/>
                        <TextBlock x:Name="diffFriends" FontFamily="Montserrat" Foreground="{StaticResource titleColor1}"/>
                    </UniformGrid>
                    <TextBlock x:Name="txtSummary" TextWrapping="Wrap" Style="{StaticResource CompareLabelText}" FontSize="12"/>
                </StackPanel>
            </Border>
                </Grid>

                <!-- Additional Info Section -->
                <Border Margin="0,18,0,0" Background="{StaticResource ComparePanelBackground}" Padding="14" CornerRadius="8" BorderBrush="{StaticResource panelOverColor}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Additional Information" FontFamily="Montserrat" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Left user extra info -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="User 1" FontFamily="Montserrat" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                <UniformGrid Columns="2" Rows="4">
                                    <TextBlock Text="Country"/>
                                    <TextBlock x:Name="txtCountry1"/>
                                    <TextBlock Text="Organization"/>
                                    <TextBlock x:Name="txtOrg1"/>
                                    <TextBlock Text="Contribution"/>
                                    <TextBlock x:Name="txtContribution1"/>
                                    <TextBlock Text="Registration"/>
                                    <TextBlock x:Name="txtReg1"/>
                                </UniformGrid>
                            </StackPanel>
                            <!-- Right user extra info -->
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="User 2" FontFamily="Montserrat" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                <UniformGrid Columns="2" Rows="4">
                                    <TextBlock Text="Country"/>
                                    <TextBlock x:Name="txtCountry2"/>
                                    <TextBlock Text="Organization"/>
                                    <TextBlock x:Name="txtOrg2"/>
                                    <TextBlock Text="Contribution"/>
                                    <TextBlock x:Name="txtContribution2"/>
                                    <TextBlock Text="Registration"/>
                                    <TextBlock x:Name="txtReg2"/>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Tag Overlap Section -->
                <Border Margin="0,18,0,0" Background="{StaticResource ComparePanelBackground}" Padding="14" CornerRadius="8" BorderBrush="{StaticResource panelOverColor}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Tag Overlap" FontFamily="Montserrat" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                        <TextBlock x:Name="txtTagsOverlap" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource titleColor1}"/>
                    </StackPanel>
                </Border>

                <!-- Difficulty Distribution Section -->
                <Border Margin="0,18,0,0" Background="{StaticResource ComparePanelBackground}" Padding="14" CornerRadius="8" BorderBrush="{StaticResource panelOverColor}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Difficulty Distribution" FontFamily="Montserrat" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                        <TextBlock x:Name="txtDifficulty" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource titleColor1}"/>
                    </StackPanel>
                </Border>

                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
