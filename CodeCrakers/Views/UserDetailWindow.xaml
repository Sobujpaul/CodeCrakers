<Window x:Class="CodeCrakers.Views.UserDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Details" WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight">
    <Border Padding="20">
        <StackPanel Width="600">
            <StackPanel.Resources>
                <Style TargetType="FrameworkElement">
                    <Setter Property="Margin" Value="0,0,0,8"/>
                </Style>
            </StackPanel.Resources>
            <TextBlock x:Name="txtTitle" FontSize="20" FontWeight="SemiBold"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Codeforces" FontWeight="Bold"/>
                    <TextBlock x:Name="cfRating"/>
                    <TextBlock x:Name="cfSolved"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="LeetCode" FontWeight="Bold"/>
                    <TextBlock x:Name="lcRating"/>
                    <TextBlock x:Name="lcSolved"/>
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CodeChef" FontWeight="Bold"/>
                    <TextBlock x:Name="ccRating"/>
                    <TextBlock x:Name="ccSolved"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="AtCoder" FontWeight="Bold"/>
                    <TextBlock x:Name="acRating"/>
                    <TextBlock x:Name="acSolved"/>
                </StackPanel>
            </Grid>
            <Separator/>
            <TextBlock x:Name="summary"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button IsCancel="True">Close</Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

