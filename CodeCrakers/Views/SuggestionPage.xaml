<UserControl x:Class="CodeCrakers.Views.SuggestionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource panelColor}" CornerRadius="10" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Problem Suggestions" 
                               Foreground="{StaticResource titleColor1}"
                               FontFamily="Montserrat" FontSize="20" FontWeight="Medium"/>
                    <TextBlock x:Name="txtSubtitle" Text="" Margin="10,0,0,0"
                               Foreground="{StaticResource plainTextColor1}"
                               FontFamily="Montserrat" FontSize="12"/>
                </StackPanel>
                <CheckBox x:Name="chkAutoRefresh" Grid.Column="1" Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          Foreground="{StaticResource plainTextColor1}"
                          Content="Auto refresh"/>
                <Button Grid.Column="2" x:Name="btnRefresh" Content="Refresh" Padding="10,6" Margin="0,0,0,0"
                        Background="{StaticResource color1}" Foreground="White" BorderThickness="0"
                        Click="btnRefresh_Click"/>
            </Grid>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Background="{StaticResource panelColor}" CornerRadius="10" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Showing unsolved Codeforces problems between your rating - 100 and rating + 200" 
                               Foreground="{StaticResource plainTextColor1}"
                               FontFamily="Montserrat" FontSize="12"/>
                    <ProgressBar x:Name="progress" Width="120" Height="6" Margin="10,0,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="lstProblems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource panelOverColor}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" 
                                                   Foreground="{StaticResource titleColor1}"
                                                   FontFamily="Montserrat" FontSize="14" FontWeight="Medium"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Rating: " Foreground="{StaticResource plainTextColor2}"/>
                                            <TextBlock Text="{Binding Rating}" Foreground="{StaticResource plainTextColor1}"/>
                                            <TextBlock Text="  •  " Foreground="{StaticResource plainTextColor2}"/>
                                            <TextBlock Text="Open" Foreground="{StaticResource color1}" Cursor="Hand" TextDecorations="Underline">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenProblemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                </TextBlock.InputBindings>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
