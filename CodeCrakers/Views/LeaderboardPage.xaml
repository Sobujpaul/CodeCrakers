<UserControl x:Class="CodeCrakers.Views.LeaderboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CodeCrakers.Converters"
             xmlns:local="clr-namespace:CodeCrakers.Views">
    <UserControl.Resources>
        <conv:TickCrossConverter x:Key="TickCrossConverter"/>
    </UserControl.Resources>

    <StackPanel Margin="10">
        <!-- Filters & Sorting -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox x:Name="cmbSort" Width="150">
                <ComboBoxItem Content="Rating" Tag="rating" IsSelected="True"/>
                <ComboBoxItem Content="Solved Problems" Tag="solved"/>
            </ComboBox>

            <TextBox x:Name="txtSearch" Width="200" Margin="10,0,0,0" Text="Search Codeforces" Foreground="Gray" GotFocus="txtSearch_GotFocus" LostFocus="txtSearch_LostFocus"/>
            <TextBox x:Name="txtCountry" Width="150" Margin="10,0,0,0" Text="Country" Foreground="Gray" GotFocus="txtCountry_GotFocus" LostFocus="txtCountry_LostFocus"/>
            <TextBox x:Name="txtUniversity" Width="150" Margin="10,0,0,0" Text="University" Foreground="Gray" GotFocus="txtUniversity_GotFocus" LostFocus="txtUniversity_LostFocus"/>
            <Button Content="Apply" Click="btnApplyFilters_Click" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Leaderboard Table -->
        <DataGrid x:Name="dgLeaderboard" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="50"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>

                <DataGridTemplateColumn Header="Codeforces">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding HasCodeforces, Converter={StaticResource TickCrossConverter}}"
                                    Click="PlatformButton_Click"
                                    Tag="codeforces"
                                    IsEnabled="{Binding HasCodeforces}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="CodeChef">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding HasCodeChef, Converter={StaticResource TickCrossConverter}}"
                                    Click="PlatformButton_Click"
                                    Tag="codechef"
                                    IsEnabled="{Binding HasCodeChef}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="LeetCode">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding HasLeetCode, Converter={StaticResource TickCrossConverter}}"
                                    Click="PlatformButton_Click"
                                    Tag="leetcode"
                                    IsEnabled="{Binding HasLeetCode}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="AtCoder">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding HasAtCoder, Converter={StaticResource TickCrossConverter}}"
                                    Click="PlatformButton_Click"
                                    Tag="atcoder"
                                    IsEnabled="{Binding HasAtCoder}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- Pagination -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Previous" Click="btnPrevious_Click"/>
            <TextBlock x:Name="txtPageInfo" Margin="10,0"/>
            <Button Content="Next" Click="btnNext_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
