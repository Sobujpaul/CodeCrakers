<UserControl x:Class="CodeCrakers.Views.LeaderboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:views="clr-namespace:CodeCrakers.Views">
    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <views:InvertBoolToVisibilityConverter x:Key="InvertBoolToVisibility"/>
        <views:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <views:InvertStringToVisibilityConverter x:Key="InvertStringToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                CornerRadius="0,10,0,0"
                Background="{StaticResource panelColor}">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="20,0">
                <fa:IconImage Icon="Table" Style="{StaticResource menuButtonIcon}" Margin="0,0,10,0"/>
                <TextBlock Text="Leaderboard"
                           Foreground="{StaticResource titleColor1}"
                           FontFamily="Montserrat"
                           FontSize="24"
                           FontWeight="Medium"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Controls -->
            <Border Grid.Row="0" 
                    CornerRadius="10" 
                    Background="{StaticResource panelColor}"
                    Padding="15" 
                    Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="FrameworkElement">
                            <Setter Property="Margin" Value="0,0,10,0"/>
                        </Style>
                    </StackPanel.Resources>
                    <TextBox x:Name="txtSearch" Width="220" TextChanged="txtSearch_TextChanged" 
                             Background="{StaticResource secondaryBackColor1}" 
                             Foreground="{StaticResource titleColor1}"
                             BorderBrush="{StaticResource color2}"
                             Padding="8"/>
                    <ComboBox x:Name="cmbSort" Width="200" SelectionChanged="cmbSort_SelectionChanged"
                              Background="{StaticResource secondaryBackColor1}" 
                              Foreground="{StaticResource titleColor1}"
                              BorderBrush="{StaticResource color2}">
                        <ComboBoxItem Content="Rank" Tag="rank"/>
                        <ComboBoxItem Content="Problems Solved" Tag="problems"/>
                        <ComboBoxItem Content="Highest Rating" Tag="rating"/>
                    </ComboBox>
                    <ToggleButton x:Name="btnSortDir" Width="40" Checked="btnSortDir_Checked" Unchecked="btnSortDir_Unchecked"
                                  Background="{StaticResource secondaryBackColor1}" 
                                  BorderBrush="{StaticResource color2}">
                        <fa:IconImage Icon="ArrowDownAZ" Width="16" Height="16" Foreground="{StaticResource titleColor1}"/>
                    </ToggleButton>
                    <ComboBox x:Name="cmbCountry" Width="180" SelectionChanged="cmbFilter_Changed"
                              Background="{StaticResource secondaryBackColor1}" 
                              Foreground="{StaticResource titleColor1}"
                              BorderBrush="{StaticResource color2}"/>
                    <ComboBox x:Name="cmbUniversity" Width="220" SelectionChanged="cmbFilter_Changed"
                              Background="{StaticResource secondaryBackColor1}" 
                              Foreground="{StaticResource titleColor1}"
                              BorderBrush="{StaticResource color2}"/>
                    <Button x:Name="btnRefresh" Click="btnRefresh_Click"
                            Background="{StaticResource color2}" 
                            Foreground="White"
                            Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Rotate" Width="14" Height="14"/>
                            <TextBlock Text="Refresh" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Leaderboard Table -->
            <Border Grid.Row="1" 
                    CornerRadius="10" 
                    Background="{StaticResource panelColor}"
                    Padding="15">
                <DataGrid x:Name="gridLeaderboard"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          MouseDoubleClick="gridLeaderboard_MouseDoubleClick"
                          Background="{StaticResource panelColor}"
                          BorderBrush="{StaticResource color2}"
                          GridLinesVisibility="Horizontal"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="True">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource secondaryBackColor1}"/>
                            <Setter Property="Foreground" Value="{StaticResource titleColor1}"/>
                            <Setter Property="FontFamily" Value="Montserrat"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Setter Property="Padding" Value="10,8"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{StaticResource panelColor}"/>
                            <Setter Property="Foreground" Value="{StaticResource titleColor1}"/>
                            <Setter Property="FontFamily" Value="Montserrat"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource panelOverColor}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource panelActiveColor}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="60" CanUserResize="True"/>
                        <DataGridTextColumn Header="Name (Codeforces)" Binding="{Binding DisplayName}" Width="*" CanUserResize="True"/>
                        <DataGridTextColumn Header="Current Rating" Binding="{Binding HighestRating}" Width="120" CanUserResize="True"/>
                        <DataGridTemplateColumn Header="Codeforces" Width="150" CanUserResize="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Cursor="Hand" MouseLeftButtonUp="PlatformUsername_Click" Tag="Codeforces">
                                        <StackPanel>
                                            <TextBlock Text="Codeforces" 
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource codeforcesColor}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Codeforces}" 
                                                       Foreground="{Binding CodeforcesStats.IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=LimeGreen|Gray}"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding Codeforces, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            <TextBlock Text="✖" 
                                                       Foreground="Red"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding Codeforces, Converter={StaticResource InvertStringToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="LeetCode" Width="150" CanUserResize="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Cursor="Hand" MouseLeftButtonUp="PlatformUsername_Click" Tag="LeetCode">
                                        <StackPanel>
                                            <TextBlock Text="LeetCode" 
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource leetcodeColor}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding LeetCode}" 
                                                       Foreground="{Binding LeetCodeStats.IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=LimeGreen|Gray}"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding LeetCode, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            <TextBlock Text="✖" 
                                                       Foreground="Red"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding LeetCode, Converter={StaticResource InvertStringToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="CodeChef" Width="150" CanUserResize="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Cursor="Hand" MouseLeftButtonUp="PlatformUsername_Click" Tag="CodeChef">
                                        <StackPanel>
                                            <TextBlock Text="CodeChef" 
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource codechefColor}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Codechef}" 
                                                       Foreground="{Binding CodechefStats.IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=LimeGreen|Gray}"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding Codechef, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            <TextBlock Text="✖" 
                                                       Foreground="Red"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding Codechef, Converter={StaticResource InvertStringToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="AtCoder" Width="150" CanUserResize="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Cursor="Hand" MouseLeftButtonUp="PlatformUsername_Click" Tag="AtCoder">
                                        <StackPanel>
                                            <TextBlock Text="AtCoder" 
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource atcoderColor}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Atcoder}" 
                                                       Foreground="{Binding AtcoderStats.IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=LimeGreen|Gray}"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding Atcoder, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            <TextBlock Text="✖" 
                                                       Foreground="Red"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding Atcoder, Converter={StaticResource InvertStringToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Problems Solved" Binding="{Binding TotalProblemsSolved}" Width="120" CanUserResize="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Pagination -->
            <Border Grid.Row="2" 
                    CornerRadius="10" 
                    Background="{StaticResource panelColor}"
                    Padding="15" 
                    Margin="0,15,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel.Resources>
                        <Style TargetType="FrameworkElement">
                            <Setter Property="Margin" Value="0,0,8,0"/>
                        </Style>
                    </StackPanel.Resources>
                    <Button x:Name="btnPrev" Click="btnPrev_Click"
                            Background="{StaticResource color2}" 
                            Foreground="White"
                            Padding="10,5">Prev</Button>
                    <TextBlock x:Name="txtPageInfo" VerticalAlignment="Center" 
                               Foreground="{StaticResource titleColor1}"
                               FontFamily="Montserrat"/>
                    <Button x:Name="btnNext" Click="btnNext_Click"
                            Background="{StaticResource color2}" 
                            Foreground="White"
                            Padding="10,5">Next</Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
