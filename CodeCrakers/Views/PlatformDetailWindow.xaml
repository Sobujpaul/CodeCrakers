<Window x:Class="CodeCrakers.Views.PlatformDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Platform Stats" Height="400" Width="400" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="10">

        <TextBlock x:Name="txtTitle" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" TextAlignment="Center"/>

        <StackPanel x:Name="statsPanel" Margin="0,10,0,0">
            <!-- Stats will be dynamically added here -->
        </StackPanel>

        <Button Content="Close" HorizontalAlignment="Center" Margin="0,20,0,0" Width="80" Click="btnClose_Click"/>
    </StackPanel>
</Window>
