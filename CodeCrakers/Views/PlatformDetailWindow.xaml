<Window x:Class="CodeCrakers.Views.PlatformDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Platform Stats"
        Height="420" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource panelColor}"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource titleColor1}"/>
            <Setter Property="FontFamily" Value="Montserrat"/>
        </Style>
    </Window.Resources>

    <Border Margin="12" Padding="16"
            Background="{StaticResource panelOverColor}"
            BorderBrush="{StaticResource color1}"
            BorderThickness="1"
            CornerRadius="12">
        <StackPanel>
            <TextBlock x:Name="txtTitle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" TextAlignment="Center"/>

            <StackPanel x:Name="statsPanel" Margin="0,8,0,0">
                <!-- Stats will be dynamically added here -->
            </StackPanel>

            <Button Content="Close"
                    Click="btnClose_Click"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0"
                    Width="96"
                    Padding="8,4"
                    Background="{StaticResource color2}"
                    Foreground="{StaticResource titleColor1}"
                    BorderBrush="Transparent"
                    Cursor="Hand"/>
        </StackPanel>
    </Border>
</Window>
